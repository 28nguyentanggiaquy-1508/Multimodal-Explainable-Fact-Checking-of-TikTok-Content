# Never commit a real .env file. Keep secrets only in backend/.env locally.

# ========================
# Gemini / VLM
# ========================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_ANALYST_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=2
GEMINI_CIRCUIT_DEFAULT_SECONDS=900

# ========================
# Phase 3 source discovery
# ========================
# brave_then_gemini | brave | gemini
EVIDENCE_SEARCH_PROVIDER=brave_then_gemini
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_API_KEY
BRAVE_SEARCH_COUNTRY=VN
BRAVE_SEARCH_LANG=vi

# MOCHEG-inspired retrieval models
TEXT_RETRIEVAL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
IMAGE_RETRIEVAL_MODEL=openai/clip-vit-base-patch32
WEB_SEARCH_MAX_RESULTS=10
TEXT_RETRIEVAL_TOP_N=20
IMAGE_RETRIEVAL_TOP_N=10
TEXT_EVIDENCE_TOP_K=5
IMAGE_EVIDENCE_TOP_K=3
MAX_CHECK_WORTHY_CLAIMS=10

# Optional LLM relevance reranker. Default false for reproducible retrieval.
EVIDENCE_USE_LLM_RERANKER=false
REASONING_USE_GEMINI=false

# CoReS-inspired filtering (project defaults, not paper hyperparameters)
CONCEPT_CLUSTER_THRESHOLD=0.86
CONCEPT_CLAIM_THRESHOLD=0.40
CONCEPT_MIN_FREQ_RATIO=0.20

# Phase 4
VERIFICATION_MAX_IMAGES=3
VERIFICATION_MAX_EVIDENCE_CHARS=1800

# Network safeguards
EVIDENCE_REQUEST_TIMEOUT=10
EVIDENCE_MAX_PAGE_BYTES=2000000
EVIDENCE_MAX_IMAGE_BYTES=8000000

# Evidence diversity
EVIDENCE_MAX_PER_URL=1
EVIDENCE_MAX_PER_DOMAIN=2

# CORS
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Final verification can batch multiple claims into one call.
VERIFICATION_BATCH_ENABLED=true
VERIFICATION_BATCH_MAX_CLAIMS=10
VERIFICATION_BATCH_MAX_IMAGES_TOTAL=6

# Phase 3 temporal evidence hardening
TEMPORAL_SEARCH_LOOKBACK_DAYS=730
TEMPORAL_STRICT_CURRENT_STATE=true

# ================= V2.3 MULTI-VLM =================
# OpenAI API billing is separate from ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VLM_MODEL=gpt-6-luna
OPENAI_VLM_MODELS=gpt-6-luna
OPENAI_VERIFICATION_MODELS=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Provider failover order.
VLM_PROVIDER_ORDER=openai,gemini
VLM_VERIFICATION_PROVIDER_ORDER=openai,gemini

# OpenAI Phase 2 samples frames + transcribes MP4 audio.
OPENAI_PHASE2_FRAME_COUNT=10
OPENAI_PHASE2_TRANSCRIBE=true
OPENAI_IMAGE_DETAIL=low
OPENAI_VLM_TIMEOUT=120
OPENAI_PHASE2_MAX_OUTPUT_TOKENS=4000
OPENAI_PHASE4_MAX_OUTPUT_TOKENS=3000

# Optional persistent circuit path. Leave empty to use backend/runtime/vlm_circuit_state.json
VLM_CIRCUIT_STATE_FILE=
